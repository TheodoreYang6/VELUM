# ---- 智能解读（可选）----
# 服务端 Key。默认【不会】被访客使用，见下方 ALLOW_SERVER_KEY。
# 推荐做法：每位使用者在前端「模型连接」里填自己的 Key，服务器不必配置。
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=DeepSeek-V4.1-Flash-1017
DEEPSEEK_MODEL_FALLBACK=deepseek-flash
LLM_ENABLED=true
LLM_TIMEOUT=40

# ---- 共享开关（重要）----
# false（默认）：服务端 Key 只在你显式开启时才会被使用；未填个人 Key 的访客
#               一律回退规则稿，不会消耗你的额度。公网部署请务必保持 false。
# true         ：允许「未携带个人 Key」的请求使用服务端 Key（等于替所有访客付费）。
#               个人 Key 始终优先，不会被服务端 Key 覆盖。
ALLOW_SERVER_KEY=false

# ---- 服务 / 鉴权（可选，均有默认值）----
# 允许跨域的来源（逗号分隔）；仅在前端独立部署于其他域名时需要修改
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 会话 Cookie 的 Secure 属性；HTTPS 部署请设为 true
SESSION_SECURE=false

